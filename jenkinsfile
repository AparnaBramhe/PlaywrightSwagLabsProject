
pipeline {

    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['QA', 'Stage', 'Dev'],
            description: 'Select environment'
        )
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {

        // 1. CHECKOUT CODE
        stage('Checkout Code') {
            steps {
                echo 'CHECKOUT CODE'

                git(
                    url: 'https://github.com/AparnaBramhe/PlaywrightSwagLabsProject.git',
                    branch: 'master'
                )
            }
        }

        // 2. CHECK NODE
        stage('Check Node') {
            steps {
                nodejs('NodeJS26') {
                    bat '''
                        node --version
                        npm --version
                    '''
                }
            }
        }

        // 3. INSTALL DEPENDENCIES
        stage('Install Dependencies') {
            steps {
                nodejs('NodeJS26') {
                    bat 'npm ci'
                }
            }
        }

        // 4. INSTALL PLAYWRIGHT
        stage('Install Playwright') {
            steps {
                nodejs('NodeJS26') {
                    bat 'npx playwright install chromium'
                }
            }
        }

        // 5. VERIFY ENVIRONMENT
        stage('Verify Environment') {
            steps {
                echo "Selected environment: ${params.ENVIRONMENT}"

                withCredentials([
                    string(
                        credentialsId: 'app_url',
                        variable: 'APP_URL'
                    )
                ]) {
                    nodejs('NodeJS26') {
                        bat '''
                            if not defined APP_URL (
                                echo ERROR: APP_URL is missing
                                exit /b 1
                            )

                            echo APP_URL credential is available
                        '''
                    }
                }
            }
        }

        // 6. RUN PLAYWRIGHT UI TESTS
        stage('Run UI Tests') {
            steps {
                echo "Running tests for: ${params.ENVIRONMENT}"

                withCredentials([
                    string(
                        credentialsId: 'app_url',
                        variable: 'APP_URL'
                    ),
                    string(
                        credentialsId: 'app_username',
                        variable: 'APPUSERNAME'
                    ),
                    string(
                        credentialsId: 'app_password',
                        variable: 'APPPASSWORD'
                    ),
                    string(
                        credentialsId: 'api_url',
                        variable: 'API_URL'
                    ),
                    string(
                        credentialsId: 'access_token',
                        variable: 'ACCESSTOKEN'
                    )
                ]) {
                    nodejs('NodeJS26') {
                        bat """
                            set "ENV=${params.ENVIRONMENT.toLowerCase()}"
                            set "APPBASEURL=%APP_URL%"

                            echo Environment: %ENV%
                            echo Starting Playwright tests...

                            npx playwright test --project=ui
                        """
                    }
                }
            }
        }

        // 7. GENERATE ALLURE REPORT
        stage('Generate Allure Report')
        {
            steps {
                nodejs('NodeJS26') {
                    bat '''
                        if exist allure-results (
                            npx allure generate allure-results -o allure-report --clean
                        ) else (
                            echo No allure-results directory found
                            exit /b 1
                        )
                    '''
                }
            }
        }

        // 8. CUSTOMIZE ALLURE REPORT
        stage('Customize Allure Report') {
            steps {
                nodejs('NodeJS26') {
                    bat '''
                        node src/allure/customize-allure-report.js
                    '''
                }
            }
        }

        // 9. PUBLISH ALLURE REPORT
        stage('Publish Allure Report') {
            steps {
                allure([
                    includeProperties: false,
                    results: [
                        [path: 'allure-results']
                    ]
                ])
            }
        }

        // 10. ARCHIVE REPORTS
        stage('Archive Reports') {
            steps {
                archiveArtifacts(
                    artifacts: 'allure-results/**,allure-report/**,reports/html-report/**',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }
    }

    // POST EXECUTION
    post {

        always {
            echo '======================================'
            echo 'PIPELINE SUMMARY'
            echo '======================================'

            echo "Environment: ${params.ENVIRONMENT}"
            echo "Build Number: ${BUILD_NUMBER}"
            echo "Build Result: ${currentBuild.currentResult}"
            echo "Build URL: ${BUILD_URL}"

            // Archive reports generated before a failure
            archiveArtifacts(
                artifacts: 'allure-results/**,allure-report/**,reports/html-report/**',
                allowEmptyArchive: true,
                fingerprint: true
            )

            // EMAIL NOTIFICATION
            script {
                def finalStatus = currentBuild.currentResult

                try {
                    withCredentials([
                        string(
                            credentialsId: 'mail_username',
                            variable: 'MAIL_USERNAME'
                        ),
                        string(
                            credentialsId: 'mail_password',
                            variable: 'MAIL_APP_PASSWORD'
                        ),
                        string(
                            credentialsId: 'student_email',
                            variable: 'STUDENT_EMAILS'
                        )
                    ]) {
                        withEnv([
                            "BUILD_STATUS=${finalStatus}",
                            "TEST_ENVIRONMENT=${params.ENVIRONMENT}",
                            "BUILD_NUMBER=${env.BUILD_NUMBER}",
                            "BUILD_URL=${env.BUILD_URL}",
                            "ALLURE_REPORT_URL=${env.BUILD_URL}allure/"
                        ]) {
                            nodejs('Node24') {
                                def emailExitCode = bat(
                                    script: 'npx tsx src/email/send-report-email.ts',
                                    returnStatus: true
                                )

                                if (emailExitCode != 0) {
                                    echo 'WARNING: Email notification failed. Check the email logs.'
                                } else {
                                    echo 'Email script completed successfully.'
                                }
                            }
                        }
                    }
                } catch (Exception e) {
                    echo "WARNING: Email notification error: ${e.getMessage()}"
                }
            }
        }

        success {
            echo '======================================'
            echo 'PLAYWRIGHT PIPELINE PASSED'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'PLAYWRIGHT PIPELINE FAILED'
            echo '======================================'
        }
    }
}