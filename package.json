{
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "papaparse": "^5.7.0",
    "playwright": "^1.62.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/papaparse": "^5.5.2",
    "allure-playwright": "^3.12.0",
    "cross-env": "^10.1.0",
    "reporting-labs": "^0.6.5"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test -headed",
    "test:chrome": "npx playwright test --project=chromiun",
    "allure:generate": "npx allure generate allure-results -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "allure:clean": "Remove-Item -Recurse -Force allure-report",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:qa": "cross-env ENV=qa playwright test",
    "test:stage": "cross-env ENV=stage playwright test"
  }
}
